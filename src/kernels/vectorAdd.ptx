.version 7.0
.target sm_75
.address_size 64



.visible .entry vectorAdd(
        .param .u64 param0,
        .param .u64 param1,
        .param .u64 param2,
        .param .u32 param3
)
{
        .reg .pred      %p<2>;
        .reg .b32       %r<5>;
        .reg .b64       %rd<9>;

        ld.param.u64    %rd1, [param0];
        ld.param.u64    %rd2, [param1];
        ld.param.u64    %rd3, [param2];
        ld.param.u32    %r1, [param3];

        mov.u32         %r2, %tid.x;
        setp.lt.u32     %p1, %r2, %r1;
        @%p1 bra        $L__BB0_2;

        ret;

$L__BB0_2:
        mul.wide.u32    %rd4, %r2, 4;
        add.s64         %rd5, %rd1, %rd4;
        add.s64         %rd6, %rd2, %rd4;
        add.s64         %rd7, %rd3, %rd4;

        ld.global.u32   %r3, [%rd5];
        ld.global.u32   %r4, [%rd6];
        add.u32         %r5, %r3, %r4;
        st.global.u32   [%rd7], %r5;

        ret;
}
