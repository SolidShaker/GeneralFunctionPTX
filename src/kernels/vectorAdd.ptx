//
// Vector addition kernel: C[i] = A[i] + B[i]
// Fixed for PTX 6.5+
//
.version 6.5
.target sm_75
.address_size 64

.visible .entry krVecAdd(
    .param .u64 param_A,
    .param .u64 param_B,
    .param .u64 param_C,
    .param .u32 param_N
)
{
    .reg .pred      %p<1>;
    .reg .f32       %f<4>;
    .reg .u64       %rd<8>;
    .reg .u32       %r<6>;
    
    // Load parameters
    ld.param.u64    %rd1, [param_A];
    ld.param.u64    %rd2, [param_B];
    ld.param.u64    %rd3, [param_C];
    ld.param.u32    %r1, [param_N];
    
    // Get thread indices
    mov.u32         %r2, %tid.x;
    mov.u32         %r3, %ctaid.x;
    mov.u32         %r4, %ntid.x;
    
    // Calculate global index = blockIdx.x * blockDim.x + threadIdx.x
    mad.lo.s32      %r5, %r3, %r4, %r2;
    
    // Check bounds
    setp.lt.s32     %p0, %r5, %r1;
    @%p0 bra        do_add;
    exit;
    
do_add:
    // Convert index to byte offset (float = 4 bytes)
    // Use 64-bit multiplication with sign extension
    mul.wide.s32    %rd4, %r5, 4;      // %rd4 = (u64)index * 4
    
    // Add offset to base addresses
    add.u64         %rd5, %rd1, %rd4;  // addr A[index]
    add.u64         %rd6, %rd2, %rd4;  // addr B[index]
    add.u64         %rd7, %rd3, %rd4;  // addr C[index]
    
    // Load values
    ld.global.f32   %f1, [%rd5];
    ld.global.f32   %f2, [%rd6];
    
    // Add
    add.f32         %f3, %f1, %f2;
    
    // Store result
    st.global.f32   [%rd7], %f3;
    
    ret;
}
