.version 6.5
.target sm_70
.address_size 64




.visible .entry vec_add(
    .param .u64 param_A,
    .param .u64 param_B,
    .param .u64 param_C,
    .param .u32 param_N
)
{
    // Register declarations
    .reg .pred      %p <2>;
    .reg .f32       %f <3>;
    .reg .u64       %rd <10>;
    .reg .u32       %r <5>;
    
    // Load kernel parameters
    ld.param.u64    %rd1, [param_A];      // base address of A
    ld.param.u64    %rd2, [param_B];      // base address of B
    ld.param.u64    %rd3, [param_C];      // base address of C
    ld.param.u32    %r1, [param_N];       // N (number of elements)
    
    // Get thread indices
    mov.u32         %r2, %tid.x;          // thread ID in x dimension
    mov.u32         %r3, %ctaid.x;        // block ID in x dimension
    mov.u32         %r4, %ntid.x;         // block size in x dimension
    
    // Calculate global index: idx = blockIdx.x * blockDim.x + threadIdx.x
    mad.lo.s32      %r2, %r3, %r4, %r2;   // %r2 = global index
    
    // Check bounds (idx < N)
    setp.lt.s32     %p1, %r2, %r1;
    @%p1 bra        do_add;
    exit;                                   // out of bounds, exit
    
do_add:
    // Convert index to byte offset (each float = 4 bytes)
    mul.lo.s64      %rd4, %r2, 4;          // offset = index * sizeof(float)
    
    // Compute addresses: base + offset
    add.u64         %rd5, %rd1, %rd4;      // address of A[idx]
    add.u64         %rd6, %rd2, %rd4;      // address of B[idx]
    add.u64         %rd7, %rd3, %rd4;      // address of C[idx]
    
    // Load values from global memory
    ld.global.f32   %f1, [%rd5];           // load A[idx]
    ld.global.f32   %f2, [%rd6];           // load B[idx]
    
    // Perform addition
    add.f32         %f3, %f1, %f2;         // %f3 = A[idx] + B[idx]
    
    // Store result to global memory
    st.global.f32   [%rd7], %f3;           // C[idx] = result
    
    ret;
}
